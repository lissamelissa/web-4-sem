# База данных — у каждого разработчика своя локальная копия,
# в репозитории она не нужна и не должна путешествовать между ветками.
db.sqlite3

# Загруженные пользователями файлы (изображения задач, чеки) —
# тестовые данные, не часть исходного кода.
media/

# Скомпилированный Python-байткод
__pycache__/
*.pyc

# Виртуальное окружение
.venv/
venv/

# IDE
.idea/
.vscode/
